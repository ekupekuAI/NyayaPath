# OPENAI_API_KEY: Optional. Enables AI explanations (and non-English explanations).
# Get one at https://platform.openai.com/api-keys. Server-side only; never expose in client code.
# Without it, the app shows rule-based summaries of the record and an "add your API key" notice.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4.1-mini"

# PORT: Port for the Express + Vite server (default 3000).
PORT=3000

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
